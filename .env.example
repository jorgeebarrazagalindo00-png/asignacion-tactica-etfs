# Copia este archivo como ".env" (sin ".example") y rellénalo SOLO en tu computadora.
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# Supabase -> Connect (o Settings -> API) -> "Project URL"
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase -> Settings -> API Keys -> clave SECRETA (empieza con sb_secret_...).
# Da permiso de escritura: no la compartas ni la pegues en el código.
SUPABASE_SECRET_KEY=pega-aqui-la-clave-secreta

# Solo para el dashboard (lee, no escribe): Supabase -> Settings -> API Keys -> clave PUBLICABLE (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=pega-aqui-la-clave-publicable

# Opcional, solo para el pipeline: clave de la API de Gemini (Google AI Studio -> "Get API key").
# Con ella un modelo de lenguaje redacta las recomendaciones; sin ella salen de una plantilla fija.
GEMINI_API_KEY=

# Opcional: usar otro modelo de Gemini sin tocar el código.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional, solo para el panel: botón «Actualizar ahora» (le pide a GitHub Actions que corra el workflow).
# Token de GitHub (fine-grained) con acceso solo a este repositorio y permiso «Actions: Read and write».
# PANEL_GITHUB_TOKEN=github_pat_...
# PANEL_GITHUB_REPO=tu-usuario/ETF2
# PANEL_CLAVE=una-contraseña-para-el-botón
